{
  "name": "chemcanvas",
  "private": true,
  "version": "2.4.0",
  "description": "Draw, search, and export chemical structures.",
  "author": {
    "name": "Mauricio Gubert"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app:dev": "electron .",
    "app:build": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.chemcanvas.app",
    "productName": "ChemCanvas",
    "copyright": "Copyright © 2026 Mauricio Gubert",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "ChemCanvas-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "ChemCanvas-Setup.exe"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@types/three": "^0.185.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
